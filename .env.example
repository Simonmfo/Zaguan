# ============================================================================
# Zaguán Digital — Variables de Entorno (Frontend + Backend + Akuvox E12W + IA)
# Copiá este archivo a `.env.local` (frontend) y `.env` (servidor backend)
# ============================================================================

# 1. Supabase (Base de Datos Multi-Edificio, Auth y Realtime)
VITE_SUPABASE_URL=https://wjjjxdlorndnkufyyjef.supabase.co
VITE_SUPABASE_ANON_KEY=tu_publishable_o_anon_key_aqui
SUPABASE_URL=https://wjjjxdlorndnkufyyjef.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_solo_backend

# 2. IA Multimodal (Portero Virtual Voz/Function Calling + OCR Etiquetas Paquetes)
GEMINI_API_KEY=tu_gemini_api_key_aqui

# 3. Controlador Hardware Akuvox E12W (HTTP Basic / Digest Auth)
AKUVOX_BRIDGE_PORT=3001
# true = modo simulador/mock (ideal desarrollo sin portero físico) | false = conexión LAN real
AKUVOX_MOCK_MODE=true
AKUVOX_TIMEOUT_MS=3500
AKUVOX_DEFAULT_IP=192.168.1.120
AKUVOX_HTTP_PORT=80
AKUVOX_API_USER=admin
AKUVOX_API_PASSWORD=tu_password_http_api_akuvox
AKUVOX_HIGH_SECURITY_MODE=true
# Relé 2 auxiliar opcional para Doble Exclusa (ej. Shelly Pro / Akuvox SR01)
AKUVOX_SECONDARY_RELAY_URL=

# 4. Telecomunicaciones SIP / VoIP (Asterisk / FreeSWITCH / LiveKit SIP)
SIP_SERVER_HOST=192.168.1.50
SIP_PORT=5060
SIP_TRUNK_USER=e12w_entrada
SIP_TRUNK_SECRET=tu_password_sip_aqui

# 5. Notificaciones WhatsApp / Push (Opcional producción)
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
